/* HeartsStyles.uss */

/* Le conteneur global des cœurs (en haut à gauche par exemple) */
.heart-container {
    flex-direction: row; /* Aligner les cœurs horizontalement */
    flex-wrap: wrap;     /* Revenir à la ligne si trop de cœurs */
    padding: 10px;
    position: absolute;
    top: 0;
    left: 0;
}

/* Style de base pour un cœur */
.heart-icon {
    width: 32px;
    height: 32px;
    margin-right: 2px;
    margin-bottom: 2px;
    /* On garde le ratio de l'image */
    -unity-background-scale-mode: scale-to-fit;
}