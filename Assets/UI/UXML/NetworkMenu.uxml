<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Style/NetworkMenuStyle.uss" />
    <ui:VisualElement name="NetworkMenu" class="network-menu" picking-mode="Ignore">
        <ui:VisualElement class="network-menu__panel">
            <ui:Label text="TeamTimo — Partie en réseau (debug)" class="network-menu__title" />
            <ui:Button name="HostButton" text="Héberger" class="network-menu__button" />
            <ui:VisualElement class="network-menu__row">
                <ui:TextField name="AddressField" label="Adresse IP" value="127.0.0.1" class="network-menu__field" />
                <ui:Button name="JoinButton" text="Rejoindre" class="network-menu__button" />
            </ui:VisualElement>
            <ui:Label name="StatusLabel" text="" class="network-menu__status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
