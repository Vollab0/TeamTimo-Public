# =====================================================================
#  TeamTimo — .gitignore
#  Dépôt = projet Unity (racine) + vault Obsidian de Game Design (GameDesign/)
#  Base : https://github.com/github/gitignore/blob/main/Unity.gitignore
# =====================================================================

# ---------------------------------------------------------------------
#  Unity — dossiers générés (toujours reconstruits par l'éditeur)
# ---------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures / Recordings : volumineux et potentiellement sensibles
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Schémas XSD générés par UI Builder (UI Toolkit)
/[Uu][Ii][Ee]lements[Ss]chema/

# Rapport de migration de version Unity
UpgradeLog*.htm

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Fichiers de sauvegarde Blender (importés par Unity sinon)
*.blend1
*.blend1.meta

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Crashlytics generated file
crashlytics-build.properties

# ---------------------------------------------------------------------
#  IDE / solutions générées
# ---------------------------------------------------------------------
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------
#  Builds
# ---------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# ---------------------------------------------------------------------
#  Fichiers système (macOS / Windows)
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------
#  Obsidian (vault GameDesign/)
#  On VERSIONNE : la config partagée de l'équipe (app.json, appearance.json,
#  core-plugins.json, community-plugins.json, templates.json, plugins/...)
#  On IGNORE   : l'état local de chaque utilisateur (onglets ouverts, cache)
# ---------------------------------------------------------------------
GameDesign/.obsidian/workspace.json
GameDesign/.obsidian/workspace-mobile.json
GameDesign/.obsidian/workspaces.json
GameDesign/.obsidian/cache
GameDesign/.trash/

# ---------------------------------------------------------------------
#  Claude Code — réglages personnels (le .claude/settings.json partagé reste versionné)
# ---------------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
